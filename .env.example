# 大白 Baymax_pro 环境变量模板
# 复制此文件为 .env 并填入真实值（.env 已被 .gitignore 排除）

# === 智谱 AI API ===
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_CHAT_MODEL=glm-4-flash
ZHIPU_EMBED_MODEL=embedding-3

# === 路径（相对项目根目录）===
DATA_DIR=data
LOG_DIR=logs

# === 其他 ===
LOG_LEVEL=INFO
SESSION_ID=default

# === MCP 扩展（可选）===
MCP_ENABLED=1
MCP_CONFIG_PATH=mcp_servers.json
MCP_TIMEOUT=20
MCP_MAX_TOOLS=24
# 写入型工具总开关；默认关闭，开启后仍需逐次确认
MCP_ALLOW_WRITE=0

# === 语音输入 ASR（可选，离线）===
# 需要 models/vosk-model-small-cn-0.22（约 42MB）；路径可改成绝对路径
ASR_ENABLED=1
ASR_MODEL_DIR=models/vosk-model-small-cn-0.22
ASR_SAMPLE_RATE=16000
ASR_BLOCK_SIZE=4000
ASR_MAX_SECONDS=30

# === 语音播报 TTS（可选）===
TTS_ENABLED=0
# 留空 = 跟随界面 voice_mode（默认 follow 按回复语种选音色）；填了则强制使用该音色
TTS_VOICE=
TTS_VOICE_ZH=zh-CN-YunxiNeural
TTS_VOICE_ZH_TW=zh-TW-HsiaoChenNeural
TTS_VOICE_EN=en-US-BrianMultilingualNeural
TTS_VOICE_EN_US=en-US-BrianMultilingualNeural
TTS_VOICE_EN_GB=en-GB-RyanNeural
TTS_VOICE_EN_CA=en-CA-LiamNeural
TTS_VOICE_EN_HK=en-HK-SamNeural
TTS_RATE_ZH=+0%
TTS_RATE_EN=+0%
TTS_PITCH_ZH=+0Hz
TTS_PITCH_EN=+0Hz
# 仅当 TTS_VOICE 填了固定音色时生效
TTS_RATE=+0%
TTS_PITCH=+0Hz
TTS_VOLUME=+0%
TTS_MAX_CHARS=240
TTS_CHUNK_CHARS=80
TTS_SAPI_RATE=175
TTS_SAPI_VOLUME=0.9
