# 大白 Baymax_pro 环境变量模板
# 复制此文件为 .env 并填入真实值（.env 已被 .gitignore 排除）

# === 智谱 AI API ===
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_CHAT_MODEL=glm-4-flash
ZHIPU_EMBED_MODEL=embedding-3

# === 路径（相对项目根目录）===
DATA_DIR=data
LOG_DIR=logs

# === 其他 ===
LOG_LEVEL=INFO
SESSION_ID=default

# === MCP 扩展（可选）===
MCP_ENABLED=1
MCP_CONFIG_PATH=mcp_servers.json
MCP_TIMEOUT=20
MCP_MAX_TOOLS=24
# 写入型工具总开关；默认关闭，开启后仍需逐次确认
MCP_ALLOW_WRITE=0

# === 语音（可选）===
TTS_ENABLED=0
# 留空 = 按文本语言自动选；填了则强制使用该音色
TTS_VOICE=
TTS_VOICE_ZH=zh-CN-YunxiNeural
TTS_VOICE_EN=en-US-AndrewNeural
TTS_RATE_ZH=-8%
TTS_RATE_EN=-18%
TTS_PITCH_ZH=+0Hz
TTS_PITCH_EN=-10Hz
# 仅当 TTS_VOICE 填了固定音色时生效
TTS_RATE=-18%
TTS_PITCH=-10Hz
TTS_VOLUME=+0%
TTS_MAX_CHARS=240
TTS_CHUNK_CHARS=80
TTS_SAPI_RATE=175
TTS_SAPI_VOLUME=0.9
