# 大白 Baymax_pro 环境变量模板
# 复制此文件为 .env 并填入真实值

# === 智谱 AI API ===
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_CHAT_MODEL=glm-4-flash
ZHIPU_EMBED_MODEL=embedding-3

# === 豆包 API（P1 语音用，后续填）===
# VOLC_APP_ID=your_volc_app_id
# VOLC_ACCESS_TOKEN=your_volc_access_token

# === 数据库 ===
DB_PATH=data/baymax.db

# === 日志 ===
LOG_LEVEL=INFO
LOG_DIR=logs
